MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 488226464}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6998518a38e760f4798c8ff97003fc0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 1351330912}
  letterPanel: {fileID: 9806365}
  characterImage: {fileID: 1770542974}
  speakerName: {fileID: 2117435863}
  dialogueText: {fileID: 1402819827}
  dialogueContinueButton: {fileID: 1619025333}
  letterImage: {fileID: 414544747}
  letterText: {fileID: 71001003}
  letterContinueButton: {fileID: 991989353}
  dialogueLines:
  - speaker: "\u9EC4\u8001\u7237"
    content: "\u548C\u4F60\u804A\u5B8C\uFF0C\u6211\u603B\u7B97\u660E\u767D\u5E08\u7236\u5F53\u5E74\u7684\u610F\u601D\u4E86\u3002"
    characterSprite: {fileID: 21300000, guid: 2601c647ff8478a4db6ee13b9e34a026, type: 3}
  - speaker: "\u9EC4\u8001\u7237"
    content: "\uFF08\u4ECE\u4EAD\u4E2D\u6697\u683C\u53D6\u51FA\u4E00\u4E2A\u6A80\u6728\u76D2\u5B50\uFF09\u8FD9\u662F\u4F60\u5E08\u7236\u56DB\u5341\u5E74\u524D\u7559\u7ED9\u6211\u7684\u3002"
    characterSprite: {fileID: 21300000, guid: 52cc7fed24004e044bfddca171d65cde, type: 3}
  - speaker: "\u9EC4\u8001\u7237"
    content: "\u4ED6\u8BF4\uFF0C\u7B49\u5230\u6709\u7F18\u4EBA\u6765\u4FEE\u8FD9\u5EA7\u4EAD\u5B50\uFF0C\u5C31\u8BA9\u6211\u8F6C\u4EA4\u3002"
    characterSprite: {fileID: 21300000, guid: 2601c647ff8478a4db6ee13b9e34a026, type: 3}
  letterContent: "\u69AB\u513F\uFF1A\r\n\u5982\u679C\u4F60\u5728\u626C\u5DDE\u62FF\u5230\u8FD9\u5C01\u4FE1\uFF0C\u8BF4\u660E\u4F60\u901A\u8FC7\u4E86\u9EC4\u8001\u7237\u7684\u8003\u9A8C\u3002\r\n\u6211\u4E2D\u5E74\u65F6\u6709\u4E2A\u6267\u5FF5\uFF1A\r\n\u7A77\u4EBA\u5BB6\u7684\u623F\u5B50\u662F\u5320\u4EBA\u8BE5\u4FEE\u7684\uFF0C\u5BCC\u4EBA\u5BB6\u7684\u623F\u5B50\u662F\u5DE5\u5320\u8BE5\u4FEE\u7684\u3002\r\n\u540E\u6765\u6211\u61C2\u4E86\uFF0C\u8FD9\u60F3\u6CD5\u662F\u9519\u7684\u3002\r\n\u9EC4\u5BB6\u4E09\u4EE3\u625B\u76D0\u5305\uFF0C\u6512\u4E0B\u5BB6\u4E1A\uFF0C\u60F3\u5EFA\u4E00\u5EA7\u4F53\u9762\u7684\u56ED\u5B50\u3002\r\n\u4ED6\u4EEC\u8BF7\u6211\u9020\u4EAD\u5B50\uFF0C\u4E0D\u662F\u4E3A\u4E86\u70AB\u8000\uFF0C\u662F\u4E3A\u4E86\u8BC1\u660E\uFF1A\r\n\u6211\u4EEC\u5BB6\uFF0C\u7EC8\u4E8E\u6709\u8D44\u683C\u4EAB\u53D7\u6587\u5316\u548C\u7F8E\u4E86\u3002\r\n\u7ED9\u5BCC\u4EBA\u9020\u623F\u5B50\uFF0C\u4E0D\u662F\u5E2E\u4ED6\u4EEC\u70AB\u8000\u3002\r\n\u662F\u5E2E\u4ED6\u4EEC\u628A\u6587\u5316\u548C\u5C0A\u4E25\uFF0C\u7559\u5728\u8FD9\u5929\u5730\u95F4\u3002\r\n\u8BB0\u4F4F\uFF1A\r\n\u94B1\u4E0D\u662F\u654C\u4EBA\uFF0C\u5320\u5FC3\u624D\u662F\u670B\u53CB\u3002\r\n\u6709\u94B1\u7684\u4EBA\u4FEE\u623F\u5B50\uFF0C\u548C\u7A77\u4EBA\u4E00\u6837\uFF0C\u90FD\u60F3\u8981\u4E00\u4E2A\u5BB6\u3002\r\n\u4E0B\u4E00\u7AD9\u53BB\u82CF\u5DDE\u3002\u90A3\u91CC\u4F1A\u6559\u4F60\uFF1A\r\n\u6280\u827A\u7684\u7EC8\u70B9\uFF0C\u662F\u521B\u9020\u3002\r\n\u5E08\u7236
    \u4E8E\u5149\u7EEA\u4E8C\u5341\u4E09\u5E74\r\n\u9644\uFF1A\u9EC4\u5BB6\u7684\u76D0\uFF0C\u662F\u8FD0\u6CB3\u4E0A\u6700\u597D\u7684\u3002\r\n\u4F60\u8981\u662F\u53BB\u676D\u5DDE\uFF0C\u5E26\u70B9\u76D0\u53BB\uFF0C\u90A3\u8FB9\u7684\u4EBA\u8BA4\u8FD9\u4E2A\u724C\u5B50\u3002"
  nextSceneName: MainMap3
