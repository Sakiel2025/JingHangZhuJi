--- !u!114 &2080864107
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2080864106}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d816d2600ae347d4db9f0aa125517300, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - questionText: "\u5728\u4FEE\u590D\u53E4\u5EFA\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u4F60\u89C9\u5F97\u4EC0\u4E48\u6700\u91CD\u8981\uFF1F"
    keywords:
    - "\u4F20\u627F"
    - "\u5DE5\u827A"
    - "\u6587\u5316"
    - "\u5386\u53F2"
    - "\u6280\u827A"
    - "\u5320\u5FC3"
    minWords: 20
    shallowResponse: "\u4FEE\u590D\u53E4\u5EFA\u53EF\u4E0D\u662F\u7B80\u5355\u7684\u6362\u6728\u5934\u3001\u5237\u6CB9\u6F06\u3002\u5E74\u8F7B\u4EBA\u554A\uFF0C
      \u8981\u591A\u60F3\u60F3\u8FD9\u4E9B\u5EFA\u7B51\u80CC\u540E\u7684\u610F\u4E49\u3002 
      \u7B97\u4E86\uFF0C\u4F60\u8FD8\u5C0F\uFF0C\u8FD9\u4E9B\u9053\u7406\u4EE5\u540E\u6162\u6162\u4F53\u4F1A\u5427\u3002"
    mediumResponse: "\u4ECA\u5929\u4F60\u7684\u624B\u827A\u6211\u770B\u5230\u4E86\uFF0C\u5F88\u624E\u5B9E\u3002\u4F46\u4FEE\u590D\u8FD9\u95E8\u5B66\u95EE\uFF0C
      \u8FD8\u6709\u66F4\u591A\u503C\u5F97\u7422\u78E8\u7684\u5730\u65B9\u3002"
    deepResponse: "\u4E0D\u9519\uFF01\u4F60\u5DF2\u7ECF\u660E\u767D\u4E86\u2014\u2014\u4FEE\u590D\u53E4\u5EFA\uFF0C\u91CD\u5728\u4F20\u627F\u5DE5\u827A\u3001
      \u5B88\u62A4\u6587\u5316\u3001\u94ED\u8BB0\u5386\u53F2\u3002\u6BCF\u4E00\u9053\u5DE5\u5E8F\u90FD\u5EF6\u7EED\u7740\u5148\u4EBA\u7684\u667A\u6167\uFF0C
      \u6BCF\u4E00\u5757\u6728\u6599\u90FD\u627F\u8F7D\u7740\u65F6\u4EE3\u7684\u8BB0\u5FC6\u3002 
      \u6280\u827A\u53EF\u4EE5\u5B66\uFF0C\u4F46\u8FD9\u4EFD\u5BF9\u6587\u5316\u7684\u656C\u754F\u548C\u5BF9\u5386\u53F2\u7684\u8D23\u4EFB\u611F\uFF0C
      \u624D\u662F\u4E00\u4E2A\u771F\u6B63\u5320\u4EBA\u7684\u54C1\u8D28\u3002\u4ECA\u5929\u4F60\u8BA9\u6211\u770B\u5230\u4E86\u5E74\u8F7B\u4E00\u4EE3
      \u7684\u5E0C\u671B\uFF01"
    profoundResponse: "\u597D\uFF01\u8BF4\u5F97\u592A\u597D\u4E86\uFF01\u4FEE\u590D\u53E4\u5EFA\uFF0C\u6838\u5FC3\u5728\u4E8E\u4F20\u627F\u5DE5\u827A\u3001
      \u5B88\u62A4\u6587\u5316\u3001\u94ED\u8BB0\u5386\u53F2\uFF0C\u7528\u6280\u827A\u4F20\u9012\u5320\u5FC3\uFF01 
      \u8FD9\u4E9B\u5EFA\u7B51\u4E0D\u53EA\u662F\u6728\u5934\u548C\u77F3\u5934\uFF0C\u66F4\u662F\u6D3B\u7740\u7684\u5386\u53F2\u6559\u79D1\u4E66\u3002
      \u6BCF\u4E00\u69AB\u3001\u6BCF\u4E00\u536F\uFF0C\u90FD\u51DD\u7ED3\u7740\u5148\u4EBA\u7684\u667A\u6167\uFF1B\u6BCF\u4E00\u51FF\u3001\u6BCF\u4E00\u5228\uFF0C
      \u90FD\u8BC9\u8BF4\u7740\u65F6\u4EE3\u7684\u6545\u4E8B\u3002  \u4F60\u4ECA\u5929\u4E0D\u4EC5\u4FEE\u597D\u4E86\u8FD9\u5730\u57FA\uFF0C\u66F4\u91CD\u8981\u7684\u662F\uFF0C\u4F60\u771F\u6B63\u61C2\u5F97\u4E86
      \u4EC0\u4E48\u53EB'\u5320\u5FC3'\u3002\u4F60\u5E08\u7236\u6536\u4E86\u4E2A\u597D\u5F92\u5F1F\uFF01"
  - questionText: "\u4E3A\u4F55\u8981\u8017\u8D39\u5982\u6B64\u5FC3\u529B\uFF0C\u4FEE\u590D\u8FD9\u4E9B\u8001\u65E7\u5EFA\u7B51\uFF1F"
    keywords:
    - "\u4EF7\u503C"
    - "\u6587\u5316"
    - "\u5386\u53F2"
    - "\u540E\u4EE3"
    - "\u4F20\u627F"
    - "\u8BB0\u5FC6"
    minWords: 20
    shallowResponse: "\u8FD9\u4E48\u591A\u5E74\uFF0C\u603B\u6709\u4EBA\u5728\u80CC\u540E\u8BF4\uFF1A'\u9EC4\u5BB6\u5C31\u4F1A\u70AB\u5BCC\uFF0C\u7528\u94B1\u5806\u623F\u5B50\u3002'
      \u6211\u4E5F\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u89E3\u91CA...  \u4E5F\u8BB8\u771F\u7684\u662F\u6211\u592A\u5728\u610F\u8FD9\u4E9B\u865A\u540D\u4E86\u5427\u3002"
    mediumResponse: "\u6211\u9EC4\u5BB6\u4E09\u4EE3\u7ECF\u8425\u76D0\u4E1A\uFF0C\u79EF\u7D2F\u4E0B\u8FD9\u4E9B\u5BB6\u4E1A\u3002\u7528\u8FD9\u4E9B\u94B1
      \u4FEE\u5EA7\u4EAD\u5B50\uFF0C\u786E\u5B9E\u662F\u60F3\u7559\u4E0B\u70B9\u4EC0\u4E48\uFF0C\u8BA9\u540E\u4EBA\u8BB0\u4F4F\u9EC4\u5BB6
      \u4E5F\u66FE\u4E3A\u6587\u5316\u505A\u8FC7\u8D21\u732E\u3002  \u4E0D\u8FC7\uFF0C\u662F\u4E0D\u662F\u70AB\u8000...\u8FD9\u4E2A\u95EE\u9898\u6211\u60F3\u4E86\u5F88\u4E45\uFF0C
      \u8FD8\u662F\u6CA1\u60F3\u660E\u767D\u3002"
    deepResponse: "\u5BF9\uFF01\u4FEE\u8FD9\u4EAD\u5B50\uFF0C\u4E0D\u662F\u4E3A\u4E86\u70AB\u8000\uFF0C\u800C\u662F\u4E3A\u4E86\u4F20\u627F\u6587\u5316\uFF0C
      \u4E3A\u540E\u4EE3\u7559\u4E0B\u5386\u53F2\u8BB0\u5FC6\u3002\u8FD9\u5EA7\u4EAD\u5B50\u89C1\u8BC1\u4E86\u626C\u5DDE\u7684\u7E41\u534E\uFF0C
      \u627F\u8F7D\u4E86\u9EC4\u5BB6\u7684\u6545\u4E8B\uFF0C\u4E5F\u4F53\u73B0\u4E86\u6C5F\u5357\u56ED\u6797\u7684\u827A\u672F\u4EF7\u503C\u3002 
      \u94B1\u662F\u6B7B\u7684\uFF0C\u6587\u5316\u662F\u6D3B\u7684\u3002\u6211\u7528\u4E09\u4EE3\u79EF\u7D2F\u5EFA\u8FD9\u5EA7\u4EAD\u5B50\uFF0C
      \u5C31\u662F\u60F3\u8BA9\u540E\u4EBA\u77E5\u9053\uFF1A\u9EC4\u5BB6\u4E0D\u53EA\u4F1A\u505A\u76D0\u751F\u610F\uFF0C\u4E5F\u61C2\u5F97
      \u5B88\u62A4\u6587\u5316\u4F20\u7EDF\u3002  \u4F60\u5E08\u7236\u5F53\u5E74\u5C31\u662F\u8FD9\u4E48\u8DDF\u6211\u8BF4\u7684\u3002\u4ECA\u5929\u542C\u4F60\u8FD9\u756A\u8BDD\uFF0C
      \u6211\u603B\u7B97\u660E\u767D\u4E86\u4ED6\u7684\u610F\u601D\uFF01"
    profoundResponse: "\u5BF9\uFF01\u4FEE\u8FD9\u4EAD\u5B50\uFF0C\u7EDD\u4E0D\u662F\u70AB\u8000\uFF01\u662F\u4E3A\u4E86\u5B88\u62A4\u6587\u5316\u4EF7\u503C\uFF0C
      \u4E3A\u540E\u4EE3\u4F20\u627F\u5386\u53F2\u8BB0\u5FC6\uFF01\u94B1\u662F\u5DE5\u5177\uFF0C\u5173\u952E\u770B\u600E\u4E48\u7528\uFF01 
      \u8FD9\u5EA7\u4EAD\u5B50\u51DD\u7ED3\u4E86\u5320\u4EBA\u7684\u5FC3\u8840\uFF0C\u627F\u8F7D\u4E86\u65F6\u4EE3\u7684\u70D9\u5370\uFF0C
      \u4F53\u73B0\u4E86\u6C5F\u5357\u56ED\u6797\u7684\u827A\u672F\u7CBE\u9AD3\u3002\u5B83\u4E0D\u4EC5\u4EC5\u5C5E\u4E8E\u9EC4\u5BB6\uFF0C
      \u66F4\u5C5E\u4E8E\u626C\u5DDE\uFF0C\u5C5E\u4E8E\u5386\u53F2\uFF01  \u6211\u9EC4\u5BB6\u4E09\u4EE3\u7ECF\u5546\uFF0C\u79EF\u7D2F\u8D22\u5BCC\u4E0D\u6613\u3002\u4F46\u8D22\u5BCC\u7559\u4E0D\u4F4F\uFF0C
      \u552F\u6709\u6587\u5316\u80FD\u4F20\u4E16\uFF01\u7528\u8FD9\u4E9B\u94B1\u4FEE\u5EFA\u8FD9\u5EA7\u4EAD\u5B50\uFF0C\u8BA9\u5B83\u6210\u4E3A
      \u6D3B\u7740\u7684\u5386\u53F2\u6559\u79D1\u4E66\uFF0C\u8FD9\u624D\u662F\u771F\u6B63\u7684\u4EF7\u503C\uFF01 
      \u4F60\u5E08\u7236\u56DB\u5341\u5E74\u524D\u5C31\u8DDF\u6211\u8BF4\uFF1A'\u94B1\u4E0D\u662F\u7F6A\u8FC7\uFF0C\u628A\u826F\u5FC3\u4FEE\u8FDB
      \u623F\u5B50\u91CC\uFF0C\u94B1\u5C31\u662F\u529F\u5FB7\u3002'\u4ECA\u5929\u4F60\u8BA9\u6211\u771F\u6B63\u660E\u767D\u4E86\u8FD9\u53E5\u8BDD\uFF01"
  - questionText: "\u4F60\u8BA4\u4E3A\u53E4\u5EFA\u4FEE\u590D\u6280\u827A\u7684\u4F20\u627F\u4E4B\u9053\u662F\u4EC0\u4E48\uFF1F"
    keywords:
    - "\u6559\u80B2"
    - "\u5B9E\u8DF5"
    - "\u521B\u65B0"
    - "\u575A\u5B88"
    - "\u4F20\u6388"
    - "\u5B66\u4E60"
    minWords: 20
    shallowResponse: "\u6211\u9EC4\u5BB6\u4E09\u4EE3\u90FD\u5728\u505A\u76D0\u751F\u610F\uFF0C\u4ECE\u6211\u7237\u7237\u625B\u76D0\u5305\u8D77\u5BB6\uFF0C
      \u5230\u6211\u8FD9\u4E00\u4EE3\u4FEE\u8FD9\u5EA7\u56ED\u5B50\u3002\u5230\u5E95\u54EA\u4E2A\u66F4\u6709\u610F\u4E49\uFF1F 
      \u6211\u4E5F\u4E0D\u77E5\u9053...\u4E5F\u8BB8\u6BCF\u4E2A\u4EBA\u7684\u6D3B\u6CD5\u90FD\u4E0D\u4E00\u6837\u5427\u3002"
    mediumResponse: "\u6211\u7237\u7237\u625B\u76D0\u5305\u517B\u6D3B\u4E86\u4E00\u5BB6\u4EBA\uFF0C\u6211\u7236\u4EB2\u5B66\u4F1A\u7ECF\u5546\u6269\u5927\u4E86
      \u751F\u610F\uFF0C\u6211\u8FD9\u4E00\u4EE3\u7528\u8D5A\u6765\u7684\u94B1\u4FEE\u5EFA\u56ED\u6797\u3002\u4E09\u4EE3\u4EBA\uFF0C\u4E09\u79CD\u6D3B\u6CD5\u3002 
      \u4F46\u771F\u6B63\u7684\u4F20\u627F\u4E4B\u9053\uFF0C\u53EF\u80FD\u4E0D\u53EA\u662F\u7B80\u5355\u7684\u804C\u4E1A\u9009\u62E9\uFF0C
      \u800C\u662F\u8981\u7406\u89E3\u6BCF\u4E2A\u804C\u4E1A\u80CC\u540E\u7684\u4EF7\u503C\u548C\u610F\u4E49\u3002 
      \u4F60\u4ECA\u5929\u7684\u8868\u73B0\u6211\u770B\u5230\u4E86\uFF0C\u6709\u624B\u827A\uFF0C\u4E5F\u6709\u60F3\u6CD5\u3002"
    deepResponse: "\u5BF9\uFF01\u4F20\u627F\u4E4B\u9053\uFF0C\u5728\u4E8E\u6559\u80B2\u4E0E\u5B9E\u8DF5\u7ED3\u5408\uFF0C\u5728\u575A\u5B88\u4F20\u7EDF\u7684\u540C\u65F6
      \u52C7\u4E8E\u521B\u65B0\u3002\u6211\u7237\u7237\u625B\u76D0\u5305\uFF0C\u4F20\u7ED9\u6211\u4EEC\u7684\u662F\u52E4\u52B3\u672C\u5206\uFF1B
      \u6211\u7236\u4EB2\u505A\u751F\u610F\uFF0C\u4F20\u7ED9\u6211\u7684\u662F\u8BDA\u4FE1\u7ECF\u8425\uFF1B\u6211\u4FEE\u56ED\u6797\uFF0C
      \u8981\u4F20\u7ED9\u540E\u4EE3\u7684\u662F\u6587\u5316\u54C1\u5473\u3002  \u5E08\u5085\u4F20\u6388\u7684\u662F\u6280\u827A\uFF0C\u5F92\u5F1F\u5B66\u4E60\u7684\u662F\u7CBE\u795E\u3002\u65E0\u8BBA\u662F\u625B\u76D0\u5305
      \u8FD8\u662F\u4FEE\u623F\u5B50\uFF0C\u53EA\u8981\u7528\u5FC3\u505A\uFF0C\u90FD\u662F\u5728\u4F20\u627F\u4E00\u79CD\u4EF7\u503C\u89C2\u3002 
      \u53EA\u6709\u7406\u8BBA\u4E0E\u5B9E\u8DF5\u5E76\u91CD\uFF0C\u4F20\u7EDF\u4E0E\u521B\u65B0\u878D\u5408\uFF0C\u8FD9\u4EFD\u7CBE\u795E
      \u624D\u80FD\u751F\u751F\u4E0D\u606F\u3002\u4F60\u4ECA\u5929\u8BA9\u6211\u770B\u5230\u4E86\u65B0\u4E00\u4EE3\u5E74\u8F7B\u4EBA\u7684\u5E0C\u671B\uFF01"
    profoundResponse: "\u771F\u6B63\u7684\u4F20\u627F\uFF0C\u662F\u6559\u80B2\u4E0E\u5B9E\u8DF5\u7684\u7EDF\u4E00\uFF0C\u662F\u575A\u5B88\u4E0E\u521B\u65B0\u7684\u5E73\u8861\uFF01
      \u6211\u7237\u7237\u625B\u76D0\u5305\u4F20\u627F\u52E4\u52B3\u672C\u5206\uFF0C\u6211\u7236\u4EB2\u505A\u751F\u610F\u4F20\u627F\u5546\u4E1A\u9053\u5FB7\uFF0C
      \u6211\u4FEE\u56ED\u6797\u4F20\u627F\u7CBE\u795E\u8FFD\u6C42\u3002\u4FEE\u623F\u5B50\u7684\u5320\u4EBA\u7528\u6280\u827A\u521B\u9020\u7F8E\uFF0C
      \u625B\u76D0\u5305\u7684\u5DE5\u4EBA\u7528\u529B\u6C14\u652F\u6491\u751F\u6D3B\u2014\u2014\u90FD\u6709\u610F\u4E49\uFF0C\u90FD\u5728\u4F20\u627F\u505A\u4EBA\u7684\u9053\u7406\uFF01
      \u4ECA\u5929\u548C\u4F60\u804A\u5B8C\uFF0C\u6211\u603B\u7B97\u660E\u767D\u5E08\u7236\u90A3\u53E5\u8BDD\u4E86\uFF1A'\u5320\u4EBA\u4FEE\u7684\u4E0D\u662F\u6728\u5934\uFF0C\u662F\u4EBA\u5FC3\u3002'
      \u4F60\u4E0D\u4EC5\u4FEE\u597D\u4E86\u6211\u7684\u4EAD\u5B50\uFF0C\u66F4\u8BA9\u6211\u660E\u767D\u4E86\u4EBA\u751F\u7684\u610F\u4E49\u3002
      \u4ECE\u4ECA\u5F80\u540E\uFF0C\u4F60\u5C31\u662F\u9EC4\u5BB6\u7684\u5EA7\u4E0A\u5BBE\uFF01"
  currentQuestionIndex: 0
  shallowReward: 10
  mediumReward: 30
  deepReward: 50
  profoundReward: 100
